{
	"name": "owasp-security-helper",
	"displayName": "OWASP Security Helper",
	"description": "Detects insecure coding practices with OWASP Top 10 rules, Content Security Policy, HTTP security headers, PHP/JS/TS/Python input validation, and file upload patterns — inline diagnostics, quick fixes, and a security report panel.",
	"version": "0.3.0",
	"publisher": "your-publisher-id",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Linters",
		"Other"
	],
	"keywords": [
		"owasp",
		"security",
		"csp",
		"content security policy",
		"secure coding",
		"vulnerability",
		"injection",
		"xss",
		"csrf"
	],
	"activationEvents": [
		"onLanguage:javascript",
		"onLanguage:javascriptreact",
		"onLanguage:typescript",
		"onLanguage:typescriptreact",
		"onLanguage:python",
		"onLanguage:php",
		"onCommand:owaspHelper.checkDependencies",
		"onCommand:owaspHelper.scanWorkspace",
		"onCommand:owaspHelper.scanWorkspaceFull",
		"onCommand:owaspHelper.showReport",
		"onCommand:owaspHelper.openSavedReport"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "owaspHelper.showReport",
				"title": "OWASP Helper: Show Security Report"
			},
			{
				"command": "owaspHelper.scanWorkspace",
				"title": "OWASP Helper: Fast Scan (No large files)"
			},
			{
				"command": "owaspHelper.scanWorkspaceFull",
				"title": "OWASP Helper: Full Scan (Including large files)"
			},
			{
				"command": "owaspHelper.checkDependencies",
				"title": "OWASP Helper: Check Dependencies"
			},
			{
				"command": "owaspHelper.checkForUpdates",
				"title": "OWASP Helper: Check for Rule Updates"
			},
			{
				"command": "owaspHelper.showRulesStatus",
				"title": "OWASP Helper: Show Rules Status"
			},
			{
				"command": "owaspHelper.openSavedReport",
				"title": "OWASP Helper: Open in Browser"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "owaspHelper.showReport"
				},
				{
					"command": "owaspHelper.scanWorkspace"
				},
				{
					"command": "owaspHelper.scanWorkspaceFull"
				},
				{
					"command": "owaspHelper.checkDependencies"
				},
				{
					"command": "owaspHelper.checkForUpdates"
				},
				{
					"command": "owaspHelper.showRulesStatus"
				},
				{
					"command": "owaspHelper.openSavedReport",
					"when": "false"
				}
			],
			"explorer/context": [
				{
					"command": "owaspHelper.scanWorkspace",
					"group": "security@1",
					"when": "explorerResourceIsFolder"
				},
				{
					"command": "owaspHelper.scanWorkspaceFull",
					"group": "security@2",
					"when": "explorerResourceIsFolder"
				},
				{
					"command": "owaspHelper.openSavedReport",
					"group": "security@1",
					"when": "resourceExtname == .html && resourcePath =~ /\\.securityReport[\\\\/]/"
				}
			],
			"editor/title": [
				{
					"command": "owaspHelper.scanWorkspace",
					"group": "navigation",
					"when": "resourceLangId =~ /javascript|typescript|python|php/"
				},
				{
					"command": "owaspHelper.scanWorkspaceFull",
					"group": "navigation",
					"when": "resourceLangId =~ /javascript|typescript|python|php/"
				}
			]
		},
		"configuration": {
			"title": "OWASP Security Helper",
			"properties": {
				"owaspHelper.enableOnSave": {
					"type": "boolean",
					"default": true,
					"description": "Run security scan automatically on file save."
				},
				"owaspHelper.severity": {
					"type": "string",
					"enum": [
						"all",
						"critical",
						"warning",
						"info"
					],
					"default": "all",
					"description": "Minimum severity level to report."
				},
				"owaspHelper.ignoredRules": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "List of rule IDs to suppress (e.g. ['A03-SQL-INJECTION'])."
				},
				"owaspHelper.fastScanExclude": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"**/node_modules/**",
						"**/out/**",
						"**/dist/**",
						"**/.venv/**",
						"**/*.min.js",
						"**/*.min.jsx"
					],
					"description": "Glob patterns to exclude during a Fast Scan (No large files)."
				},
				"owaspHelper.fullScanExclude": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"**/out/**",
						"**/dist/**"
					],
					"description": "Glob patterns to exclude during a Full Scan (Including large files)."
				},
				"owaspHelper.autoCheckForUpdates": {
					"type": "boolean",
					"default": true,
					"description": "Automatically check for new rule updates on startup (once per day)."
				},
				"owaspHelper.rulesManifestUrl": {
					"type": "string",
					"default": "https://raw.githubusercontent.com/your-org/owasp-security-helper/main/rules-manifest.json",
					"description": "URL of the remote rules manifest JSON used to check for rule updates."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run clean && npm run bundle",
		"bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
		"clean": "node -e \"require('fs').readdirSync('out', {withFileTypes:true}).forEach(f => { const p = 'out/' + f.name; if (f.isDirectory()) require('fs').rmSync(p, {recursive:true}); else if (f.name !== '.gitkeep') require('fs').unlinkSync(p); })\" || true",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src --ext ts",
		"package": "vsce package"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.85.0",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"@vscode/vsce": "^2.22.0",
		"esbuild": "^0.28.0",
		"eslint": "^8.0.0",
		"typescript": "^5.3.0"
	}
}
